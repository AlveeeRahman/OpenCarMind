{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCarMind",
  "version": "0.2.0",
  "identifier": "io.github.alveeerahman.opencarmind",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenCarMind",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "OpenCarMind desktop dashboard",
    "longDescription": "Reads the sessions an OpenCarMind board saved to its SD card and shows them in a local dashboard.",
    "icon": [
      "../../icons/32x32.png",
      "../../icons/128x128.png",
      "../../icons/128x128@2x.png",
      "../../icons/icon.icns",
      "../../icons/icon.ico"
    ]
  }
}

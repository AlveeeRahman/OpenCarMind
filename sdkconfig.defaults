# ---- Target / flash / PSRAM (Waveshare ESP32-S3-LCD-1.47, N16R8) ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# ---- Bluetooth: NimBLE, central only ----
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_LOG_LEVEL_INFO=y

# ---- Wi-Fi / BLE coexistence ----
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y

# ---- FATFS: long file names, timestamps ----
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_TIMEOUT_MS=30000

# ---- LVGL (v9) fonts used by the dashboard ----
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_USE_LOG=n
CONFIG_LV_USE_FLOAT=y

# ---- CPU monitor (FreeRTOS run-time statistics) ----
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# ---- Memory: keep internal RAM for Wi-Fi; big app buffers and the BLE heap live in PSRAM ----
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520

# Task watchdog resets the chip. Jobs are subscribed only while running and fed after every bounded step
# (sched_kick), so it fires on a step that never returns; repeated resets put the board in safe mode (sched_mon.h).
CONFIG_ESP_TASK_WDT_PANIC=y

# ---- Waveshare 1.47B panel needs inverted colours; default timezone is UTC (set SYNC_TIMEZONE in menuconfig) ----
CONFIG_LCD_INVERT_COLORS=y
CONFIG_SYNC_TIMEZONE="UTC0"

# Hardening: stack protector, no soft-AP or enterprise Wi-Fi (the board is a station only).
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
# Heap poisoning stays off: with light poisoning on, PSA ECDH fails during the TLS handshake
# (mbedtls_ssl_handshake -0x7F80), measured on this board with ESP-IDF 6.1.

# TLS to the desktop app (uploader.c), measured on the test board: buffers in PSRAM and
# sized per record, because ESP-DL leaves too little internal RAM for the fixed 16 KB record buffer (PSA error -0x008D,
# insufficient memory, in mbedtls_ssl_setup). The board is a TLS client only, with renegotiation off.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# Google's chain ends at GTS Root R4 cross-signed by GlobalSign Root CA, which ESP-IDF 6.1's bundle no longer carries.
# Cross-signed verification lets the board accept it through the GTS Root R4 it does carry (about 700 B of heap).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n

CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
